\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{reportstyle}[2026/07/22 University report style]

% Page and typography system distilled from dss_template_2024_12_24.docx.
\RequirePackage[a4paper,left=4cm,right=2cm,top=2cm,bottom=2cm,headheight=15pt]{geometry}
\RequirePackage[T1]{fontenc}
\RequirePackage[utf8]{inputenc}
\RequirePackage{newtxtext,newtxmath}
\RequirePackage{microtype}
\RequirePackage{setspace}
\RequirePackage{ragged2e}
\RequirePackage[main=english,ngerman]{babel}
\RequirePackage{csquotes}
\RequirePackage{xcolor}
\RequirePackage{colortbl}
\RequirePackage{graphicx}
\RequirePackage{tikz}
\RequirePackage{enumitem}
\RequirePackage{booktabs}
\RequirePackage{array}
\RequirePackage{longtable}
\RequirePackage{calc}
\RequirePackage{fancyhdr}
\RequirePackage{titlesec}
\RequirePackage{caption}
\RequirePackage{xurl}
\RequirePackage[hidelinks,pdfusetitle]{hyperref}
\RequirePackage{bookmark}
\RequirePackage[nameinlink,noabbrev]{cleveref}
\RequirePackage[
  backend=biber,
  style=authoryear,
  natbib=true,
  giveninits=true,
  uniquename=false,
  maxcitenames=2,
  maxbibnames=99,
  dashed=false,
  doi=true,
  url=true,
  isbn=false
]{biblatex}

\onehalfspacing
\justifying
\setlength{\parindent}{0pt}
\setlength{\parskip}{0.65em}
\setlength{\emergencystretch}{2em}
\setkeys{Gin}{width=\linewidth,height=0.78\textheight,keepaspectratio}

% Compatibility helpers for section fragments generated from Markdown.
\providecommand{\pandocbounded}[1]{#1}
\providecommand{\tightlist}{%
  \setlength{\itemsep}{0pt}\setlength{\parskip}{0pt}}

\setcounter{secnumdepth}{3}
\setcounter{tocdepth}{3}

\titleformat{\section}
  {\bfseries\fontsize{14}{17}\selectfont}
  {\thesection}{1.5em}{}
\titleformat{name=\section,numberless}
  {\bfseries\fontsize{14}{17}\selectfont}
  {}{0pt}{}
\titleformat{\subsection}
  {\bfseries\fontsize{12}{15}\selectfont}
  {\thesubsection}{1.5em}{}
\titleformat{\subsubsection}
  {\bfseries\fontsize{12}{15}\selectfont}
  {\thesubsubsection}{1.5em}{}
\titleformat{\paragraph}[block]
  {\bfseries\fontsize{12}{15}\selectfont}
  {}{0pt}{}
\titleformat{\subparagraph}[block]
  {\bfseries\itshape\fontsize{12}{15}\selectfont}
  {}{0pt}{}
\titlespacing*{\section}{0pt}{2.2em}{0.75em}
\titlespacing*{\subsection}{0pt}{1.6em}{0.55em}
\titlespacing*{\subsubsection}{0pt}{1.3em}{0.45em}
\titlespacing*{\paragraph}{0pt}{1.1em}{0.35em}
\titlespacing*{\subparagraph}{0pt}{1em}{0.3em}

\pagestyle{fancy}
\fancyhf{}
\fancyfoot[R]{\thepage}
\renewcommand{\headrulewidth}{0pt}
\renewcommand{\footrulewidth}{0pt}
\fancypagestyle{plain}{%
  \fancyhf{}
  \fancyfoot[R]{\thepage}
  \renewcommand{\headrulewidth}{0pt}
  \renewcommand{\footrulewidth}{0pt}
}

\addto\captionsenglish{%
  \renewcommand{\contentsname}{Table of contents}%
  \renewcommand{\listtablename}{List of tables}%
  \renewcommand{\listfigurename}{List of figures}%
}

% Match the source convention: figures and tables are numbered per first-level section.
\counterwithin{figure}{section}
\counterwithin{table}{section}
\renewcommand{\thefigure}{\thesection-\arabic{figure}}
\renewcommand{\thetable}{\thesection-\arabic{table}}
\captionsetup{font=small,labelfont=normalfont,justification=centering,singlelinecheck=true}
\captionsetup[figure]{name=Fig.,position=bottom}
\captionsetup[table]{name=Tab.,position=bottom}

\setlist[itemize]{leftmargin=2.2em,itemsep=0.35em,topsep=0.4em}
\setlist[enumerate]{leftmargin=2.4em,itemsep=0.35em,topsep=0.4em}

\newcommand{\makeuniversitytitle}{%
  \begin{titlepage}
    \thispagestyle{empty}
    \begin{tikzpicture}[remember picture,overlay]
      \IfFileExists{assets/lmu-seal.png}{%
        % The document has asymmetric 4 cm / 2 cm margins. Shift the seal by
        % half that difference so it shares the title text's horizontal axis.
        \node[opacity=0.08,inner sep=0pt] at ([xshift=1cm,yshift=-1.4cm]current page.center)
          {\includegraphics[width=10.5cm]{assets/lmu-seal.png}};
      }{}
    \end{tikzpicture}

    \begin{center}
      \vspace*{3.2cm}
      {\bfseries\fontsize{16}{20}\selectfont \reporttitle\par}
      \vspace{1.2cm}
      {\bfseries \partner\par}
      \vspace{0.7cm}
      {\submissionstatement\par}
      \vspace{0.3cm}
      {at the Faculty of Business Administration\par}
      \vspace{0.3cm}
      {Munich School of Management\par}
      \vspace{0.3cm}
      {Ludwig-Maximilians-Universit\"at M\"unchen\par}
    \end{center}

    \vspace{3.4cm}
    \noindent
    \begin{minipage}[t]{0.48\textwidth}
      \raggedright
      \textbf{Submitted by:}\par
      \vspace{0.55cm}
      \submittedby
    \end{minipage}%
    \hfill
    \begin{minipage}[t]{0.43\textwidth}
      \raggedright
      \textbf{Supervisor:}\par
      \vspace{0.55cm}
      \supervisor
    \end{minipage}

    \vfill
    \begin{center}
      \submissionplace, \submissiondate
    \end{center}
  \end{titlepage}
}

\newcommand{\placeholder}[1]{\textcolor{gray}{\textit{[#1]}}}

\newcommand{\pendingcontent}[2]{%
  \par\medskip
  \noindent\fcolorbox{gray!55}{gray!8}{%
    \begin{minipage}{0.92\linewidth}
      \textbf{Pending contribution: #1}\par
      \small #2
    \end{minipage}%
  }
  \par\medskip
}
